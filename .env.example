# 千界花园 — 环境变量配置
# 
# 【安全要求】此文件不包含真实 Key，仅作为模板。
# 复制为 .env 后填入真实值，并确保 .env 在 .gitignore 中。

# ═══════════════════════════════════════════════════════════════
# Kimi Code API Keys（5个，用于轮询）
# ═══════════════════════════════════════════════════════════════
KIMI_CODE_KEY_1=
KIMI_CODE_KEY_2=
KIMI_CODE_KEY_3=
KIMI_CODE_KEY_4=
KIMI_CODE_KEY_5=

# Kimi Code 可选配置
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_DEFAULT_MODEL=kimi-for-coding
KIMI_CODE_MAX_RETRIES=3
KIMI_CODE_TIMEOUT=60000

# ═══════════════════════════════════════════════════════════════
# 其他 LLM 平台 API Keys
# ═══════════════════════════════════════════════════════════════
