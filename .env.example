# 千界花园 — 环境变量配置模板
# 复制为 .env 后填写你的 API Key
# 支持 10 大 LLM Provider，填上即可使用

# ── Kimi / Moonshot (需要 User-Agent: claude-code/0.7.8) ──
# 支持最多 5 个 Key 做集群负载均衡
KIMI_API_KEY_1=
KIMI_API_KEY_2=
KIMI_API_KEY_3=
KIMI_API_KEY_4=
KIMI_API_KEY_5=
# 或只用单个 Key
MOONSHOT_API_KEY=

# ── OpenAI ──
OPENAI_API_KEY=

# ── Anthropic Claude ──
ANTHROPIC_API_KEY=

# ── DeepSeek ──
DEEPSEEK_API_KEY=

# ── 通义千问 (阿里云 DashScope) ──
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# ── Google Gemini ──
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── 智谱 GLM ──
GLM_API_KEY=
ZHIPU_API_KEY=

# ── OpenRouter ──
OPENROUTER_API_KEY=

# ── Azure OpenAI ──
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo

# ── 本地 Ollama ──
OLLAMA_BASE_URL=http://localhost:11434

# ── 数据库 ──
DATABASE_URL=postgresql://user:pass@localhost:5432/thousand_realms
REDIS_URL=redis://localhost:6379

# ── 安全 ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_ENCRYPTION_KEY=your-256-bit-encryption-key-here

# ── 后端服务 ──
TRG_BACKEND_HOST=localhost
TRG_BACKEND_PORT=3001
TRG_FRONTEND_PORT=5173

# ── Electron ──
ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true
