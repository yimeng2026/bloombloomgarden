# Agent Platform Starter — 环境变量配置

# ── 场景预设 ──
# customer-service | education | dev-team | healthcare
PRESET=customer-service

# ── 后端适配器 ──
# openclaw | dify | langchain | custom
ADAPTER_TYPE=openclaw
ADAPTER_API_BASE=http://localhost:11435
ADAPTER_API_KEY=

# ── 数据库 ──
DATABASE_URL=file:./dev.db

# ── LLM Provider API Keys ──
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=

# ── 部署 ──
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
