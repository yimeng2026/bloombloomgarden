# BloomBloomGarden — 环境变量配置模板
# 复制为 .env 后填写你的 API Key

# ── 数据库 ──
DATABASE_URL=file:./dev.db

# ── LLM Provider API Keys ──
# 智谱 GLM
ZHIPU_API_KEY=
GLM_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 通义千问 (阿里云 DashScope)
DASHSCOPE_API_KEY=
QWEN_API_KEY=

# Google Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Moonshot / Kimi
MOONSHOT_API_KEY=

# Mistral
MISTRAL_API_KEY=

# xAI
XAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# ── 部署 ──
NODE_ENV=production
PORT=3000
