# Kimi-only headless Garden configuration template.
DATABASE_URL=file:./dev.db

# Outbound model API. The key is read only by the server.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding
# Optional same-provider cluster; entries reference env names, never inline credentials.
# KIMI_CLUSTER_NODES=[{"id":"primary","apiKeyEnv":"KIMI_API_KEY","baseUrl":"https://api.kimi.com/coding/v1","maxConcurrency":5},{"id":"secondary","apiKeyEnv":"KIMI_SECONDARY_API_KEY","baseUrl":"https://api.kimi.com/coding/v1","maxConcurrency":5}]
# KIMI_SECONDARY_API_KEY=
# KIMI_RETRY_BASE_MS=1000
# GARDEN_USE_CLUSTER=1
# TOE_SYLVA_PATH=
# TOE_SYLVA_MAX_FILES=5000
# TOE_SYLVA_MAX_BYTES=52428800
# Optional bounded text input and real build configuration.
# TOE_SYLVA_TEXT_FILES=SYLVA_CHSHCore.lean
# TOE_SYLVA_LEAN_PROJECT=
# TOE_SYLVA_LEAN_TARGETS=SYLVA_CHSHCore
# LAKE_EXECUTABLE=lake
# TOE_SYLVA_AXIOM_DECLARATION=
# TOE_SYLVA_ALLOWED_AXIOMS=propext,Classical.choice,Quot.sound

# Inbound agent control. Generate an independent value with at least 32 characters.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GARDEN_AGENT_TOKEN=
GARDEN_BACKEND_URL=http://127.0.0.1:3001
# Set this when the research API is not on the request's own origin.
# GARDEN_RESEARCH_URL=http://127.0.0.1:3000
# GARDEN_AUDIT_DIR=/absolute/private/audit-directory

# Optional arXiv/KB storage. Isolated self-checks override both temporarily.
# FRONTIER_DATA_DIR=data/frontier
# FRONTIER_KB_DIR=data/frontier/kb

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
