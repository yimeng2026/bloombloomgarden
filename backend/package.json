{
  "name": "thousand-realms-garden-backend",
  "version": "1.0.0",
  "description": "千界花园 — 群智协同系统后端 v1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test:unit": "node --import tsx --test src/KimiClusterOrchestrator.test.ts",
    "start": "sh start.sh || bash start.sh || node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "prisma": "^5.13.0",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
