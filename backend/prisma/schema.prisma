datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Agent {
  id              String   @id @default(cuid())
  name            String
  role            String   @default("assistant")
  description     String?
  avatar          String?
  systemPrompt    String?
  model           String   @default("gpt-4")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(2048)
  status          String   @default("active")
  config          String   @default("{}")
  knowledgeBaseIds String   @default("[]")
  skillIds        String   @default("[]")
  workspaceId     String?
  integrationIds  String   @default("[]")
  groupId         String?
  
  // 协议分层
  protocolLevel   Int      @default(1)
  parentPlatform  String?
  threadPlatforms String   @default("[]")
  dashboardType   String   @default("L1")
  mode            String   @default("A")
  workFiles       String   @default("[]")
  
  // 蜂群
  swarmEnabled    Boolean  @default(false)
  swarmMode       String?
  roleInGroup     String   @default("solo")
  coordinatorId   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group           Group?   @relation(fields: [groupId], references: [id])
  @@index([protocolLevel])
  @@index([status])
  @@index([groupId])
}

model Group {
  id              String   @id @default(cuid())
  name            String
  description     String?
  parentId        String?
  coordinatorId   String?
  executionMode   String   @default("sequential")
  status          String   @default("active")
  maxDepth        Int      @default(1)
  
  entityIds       String   @default("[]")
  entityType      String   @default("agents")
  
  swarmMode       String   @default("sequential")
  healthScore     Int      @default(100)
  taskStats       String   @default("{}")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  agents          Agent[]
  
  @@index([parentId])
  @@index([status])
  @@index([coordinatorId])
}

model KnowledgeBase {
  id              String   @id @default(cuid())
  name            String
  description     String?
  documentIds     String   @default("[]")
  embeddingModel  String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("knowledgeBases")
}

model Document {
  id              String   @id @default(cuid())
  kbId            String
  title           String
  content         String
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id              String   @id @default(cuid())
  name            String
  description     String?
  type            String   @default("custom")
  config          String   @default("{}")
  enabled         Boolean  @default(true)
  version         String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Integration {
  id              String   @id @default(cuid())
  name            String
  type            String
  config          String   @default("{}")
  enabled         Boolean  @default(true)
  status          String   @default("disconnected")
  lastTestedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // 协议分层增强
  protocolLevel   Int      @default(1)
  threading       String   @default("single")
  protocol        String   @default("single-thread")
  providerId      String   @default("")
}

model Blueprint {
  id              String   @id @default(cuid())
  name            String
  description     String?
  steps           String   @default("[]")
  variables       String   @default("{}")
  tags            String   @default("[]")
  definition      String   @default("{}")
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Memory {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("conversation")
  tags      String   @default("[]")
  agentId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  agents      String   @default("[]")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Webhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  events      String   @default("[]")
  secret      String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id              String   @id @default("default")
  theme           String   @default("system")
  language        String   @default("zh-CN")
  notifications   Boolean  @default(true)
  autoSave        Boolean  @default(true)
  maxConcurrentAgents Int @default(10)
  defaultTimeout  Int      @default(300000)
  logLevel        String   @default("info")
  features        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id              String   @id @default(cuid())
  agentId         String
  role            String
  content         String
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
}

model WorkspaceTask {
  id              String   @id @default(cuid())
  title           String
  description     String?
  status          String   @default("pending")
  priority        String   @default("medium")
  assignee        String?
  dueDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BackendConfig {
  id              String   @id @default("default")
  name            String   @default("default")
  model           String?
  apiKey          String?
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
