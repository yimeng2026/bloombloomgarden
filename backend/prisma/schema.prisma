datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Agent {
  id              String   @id @default(uuid())
  name            String
  role            String
  status          String   @default("active")
  config          String   @default("{}") // JSON string
  knowledgeBaseIds String   @default("[]")
  skillIds        String   @default("[]")
  workspaceId     String?
  integrationIds  String   @default("[]")
  groupId         String?
  description     String?
  avatar          String?

  // --- Protocol Layer System (连连看架构) ---
  // protocolLevel: 0=infra, 1=single-thread-LLM, 2=multi-thread-orchestrator, 3=gateway
  protocolLevel   Int      @default(1)
  // parentPlatform: the L2/L3 platform that orchestrates this agent (for multi-thread mode)
  parentPlatform  String?
  // threadPlatforms: JSON array of {threadName, platformId, model} for L2 multi-thread agents
  threadPlatforms String   @default("[]")
  // dashboardType: which dashboard component to render (L0/L1/L2/L3)
  dashboardType   String   @default("L1")
  // mode: creation mode - A=single-thread, B=multi-thread, C=gateway-direct
  mode            String   @default("A")
  // workFiles: JSON array of file IDs (merged with memory hub)
  workFiles       String   @default("[]")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group           Group?   @relation(fields: [groupId], references: [id])
  @@index([protocolLevel])
  @@index([status])
  @@index([groupId])
}

model Group {
  id              String   @id @default(uuid())
  name            String
  description     String?
  parentId        String?
  coordinatorId   String?
  executionMode   String   @default("sequential")
  status          String   @default("active")
  maxDepth        Int      @default(1)

  // --- Unified Entity System ---
  // entityIds: JSON array of agentIds AND/OR nested groupIds
  // All groups are treated as agents (can be nested into parent groups)
  entityIds       String   @default("[]")
  // entityType of members: 'mixed' | 'agents' | 'groups'
  entityType      String   @default("agents")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agents          Agent[]

  @@index([parentId])
  @@index([status])
  @@index([coordinatorId])
}

model KnowledgeBase {
  id              String   @id @default(uuid())
  name            String
  description     String?
  documentIds     String   @default("[]")
  embeddingModel  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("knowledgeBases")
}

model Document {
  id              String   @id @default(uuid())
  kbId            String
  title           String
  content         String
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
}

model Skill {
  id              String   @id @default(uuid())
  name            String
  description     String?
  type            String   @default("custom")
  config          String   @default("{}")
  enabled         Boolean  @default(true)
  version         String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Integration {
  id              String   @id @default(uuid())
  name            String
  type            String
  config          String   @default("{}")
  enabled         Boolean  @default(true)
  status          String   @default("disconnected")
  lastTestedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Blueprint {
  id              String   @id @default(uuid())
  name            String
  description     String?
  steps           String   @default("[]") // JSON string
  variables       String   @default("{}")
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Settings {
  id              String   @id @default("default")
  theme           String   @default("system")
  language        String   @default("zh-CN")
  notifications   Boolean  @default(true)
  autoSave        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id              String   @id @default(uuid())
  agentId         String
  role            String
  content         String
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
}

model WorkspaceTask {
  id              String   @id @default(uuid())
  title           String
  description     String?
  status          String   @default("pending")
  priority        String   @default("medium")
  assignee        String?
  dueDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BackendConfig {
  id              String   @id @default("default")
  name            String   @default("default")
  model           String?
  apiKey          String?
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
