{
  "name": "agent-platform-starter",
  "version": "1.0.0",
  "description": "通用 AI Agent 管理平台脚手架 — 支持 OpenClaw / Dify / LangChain / 自定义",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "npx prisma db push --accept-data-loss",
    "db:seed": "npx ts-node prisma/seed.ts",
    "postinstall": "npx prisma generate",
    "docker:build": "docker build -t agent-platform .",
    "docker:up": "docker compose up -d",
    "preset:list": "node -e \"require('./src/lib/presets.js').listPresets().then(console.log)\""
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5"
  }
}
