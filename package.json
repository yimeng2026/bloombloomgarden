{
  "name": "bloombloomgarden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:research": "node node_modules/next/dist/bin/next dev",
    "dev:backend": "npm --prefix backend run dev",
    "self-check:research": "node scripts/research-self-check.mjs",
    "compare:lean": "node scripts/compare-lean-history.mjs",
    "prebuild": "node scripts/generate-kimi-operations.mjs",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node .next/standalone/server.js",
    "lint": "node node_modules/eslint/bin/eslint.js src/lib/agent-auth.ts src/lib/llm-content.ts src/lib/kimi-control.ts src/lib/kimi-gateway.ts src/lib/research-llm.ts src/lib/sylva-parser.ts src/lib/frontier/arxiv-ingest.ts src/lib/graphrag.ts src/lib/platform-adapter.ts src/app/api/kimi-control src/app/api/kimi-agent src/app/api/agents src/app/api/chat src/app/api/llm-pool tests/unit",
    "lint:all": "node node_modules/eslint/bin/eslint.js src tests/unit",
    "test": "node scripts/generate-kimi-operations.mjs --check && npx --yes bun test tests/unit",
    "db:push": "npx prisma db push",
    "db:push:unsafe": "npx prisma db push --accept-data-loss",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "duck-duck-scrape": "^2.2.7",
    "next": "16.2.9",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0",
    "yahoo-finance2": "^3.15.3",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
