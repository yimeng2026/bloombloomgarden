generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Agent {
  id            String   @id @default(uuid())
  name          String
  description   String   @default("")
  avatar        String   @default("")
  systemPrompt  String   @default("")
  model         String   @default("glm-5.1")
  temperature   Float    @default(0.7)
  apiKey        String   @default("")
  llmProvider   String   @default("zhipu")
  agentPlatform String   @default("openclaw")
  skills        String   @default("[]")
  channels      String   @default("[]")
  role          String   @default("")
  status        String   @default("idle") // idle | running | paused | error
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations    Conversation[]
  groupMemberships AgentGroupMember[]
}

model AgentGroup {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  avatar       String   @default("")
  mode         String   @default("relay")
  swarmMode    String   @default("basic") // basic | stigmergy | hierarchical | pipeline | consensus | adversarial | mentor
  humanControl String   @default("observe") // observe | approve | copilot | veto
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       AgentGroupMember[]
  conversations Conversation[]
  parentGroups  GroupGroupMember[] @relation("ChildGroups")
  childGroups   GroupGroupMember[] @relation("ParentGroups")
}

model AgentGroupMember {
  id        String   @id @default(uuid())
  agentId   String
  groupId   String
  role      String   @default("member")
  createdAt DateTime @default(now())

  agent Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  group AgentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([agentId, groupId])
}

model GroupGroupMember {
  id            String   @id @default(uuid())
  parentGroupId String
  childGroupId  String
  createdAt     DateTime @default(now())

  parentGroup AgentGroup @relation("ParentGroups", fields: [parentGroupId], references: [id], onDelete: Cascade)
  childGroup  AgentGroup @relation("ChildGroups", fields: [childGroupId], references: [id], onDelete: Cascade)

  @@unique([parentGroupId, childGroupId])
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  canvasData  String   @default("{}") // JSON: 画布节点位置/连线
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes         WorkflowNode[]
  edges         WorkflowEdge[]
  conversations Conversation[]
}

model WorkflowNode {
  id         String   @id @default(uuid())
  workflowId String
  type       String   @default("agent") // agent | group | input | output | condition | human
  refId      String   @default("") // Agent.id or AgentGroup.id
  label      String   @default("")
  config     String   @default("{}") // JSON: 节点配置
  positionX  Float    @default(0)
  positionY  Float    @default(0)
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  sourceEdges WorkflowEdge[] @relation("SourceNode")
  targetEdges WorkflowEdge[] @relation("TargetNode")
}

model WorkflowEdge {
  id         String   @id @default(uuid())
  workflowId String
  sourceId   String
  targetId   String
  label      String   @default("")
  condition  String   @default("") // 条件表达式
  createdAt  DateTime @default(now())

  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode WorkflowNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  targetNode WorkflowNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         String   @id @default(uuid())
  title      String   @default("新对话")
  agentId    String?
  groupId    String?
  workflowId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent    Agent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  group    AgentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workflow Workflow?   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  messages Message[]
}

// ===================== GraphRAG 知识图谱 =====================

model GraphRagDocument {
  id           String   @id @default(uuid())
  title        String
  content      String
  source       String   @default("manual") // manual | upload | web
  status       String   @default("pending") // pending | indexing | indexed | error
  chunkSize    Int      @default(1200)
  chunkOverlap Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chunks GraphRagChunk[]
}

model GraphRagChunk {
  id         String   @id @default(uuid())
  docId      String
  content    String
  orderIndex Int
  embedding  String   @default("") // JSON 数组字符串，简化存储
  createdAt  DateTime @default(now())

  document GraphRagDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  entities GraphRagEntity[]
}

model GraphRagEntity {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("concept") // person | organization | concept | event | location | product
  description String   @default("")
  chunkIds    String   @default("[]") // JSON 数组: 来源 chunk ID
  docIds      String   @default("[]") // JSON 数组: 来源 document ID
  communityId String?
  createdAt   DateTime @default(now())

  community       GraphRagCommunity? @relation(fields: [communityId], references: [id])
  sourceChunks    GraphRagChunk[]
  sourceRelations GraphRagRelation[] @relation("SourceEntity")
  targetRelations GraphRagRelation[] @relation("TargetEntity")
}

model GraphRagRelation {
  id          String   @id @default(uuid())
  sourceId    String
  targetId    String
  description String   @default("")
  weight      Float    @default(1.0)
  chunkIds    String   @default("[]") // JSON 数组
  createdAt   DateTime @default(now())

  sourceEntity GraphRagEntity @relation("SourceEntity", fields: [sourceId], references: [id], onDelete: Cascade)
  targetEntity GraphRagEntity @relation("TargetEntity", fields: [targetId], references: [id], onDelete: Cascade)
}

model GraphRagCommunity {
  id        String   @id @default(uuid())
  level     Int      @default(0) // 0=叶子, 1=父社区, 2=祖父社区...
  summary   String   @default("")
  entityIds String   @default("[]") // JSON 数组
  parentId  String?
  createdAt DateTime @default(now())

  entities GraphRagEntity[]
  parent   GraphRagCommunity?  @relation("CommunityHierarchy", fields: [parentId], references: [id])
  children GraphRagCommunity[] @relation("CommunityHierarchy")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  agentName      String   @default("")
  approved       Boolean  @default(true) // 人工审批标记
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ===================== Ontology 本体论系统 =====================

model OntologySchema {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  version     String   @default("1.0")
  definition  String   @default("{}")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objectTypes OntologyObjectType[]
  linkTypes   OntologyLinkType[]
  instances   OntologyInstance[]
  relations   OntologyRelation[]
  rules       OntologyRule[]
}

model OntologyObjectType {
  id          String   @id @default(uuid())
  schemaId    String
  name        String
  label       String   @default("")
  description String   @default("")
  properties  String   @default("[]")
  parentType  String?
  color       String   @default("#6366f1")
  icon        String   @default("📦")
  createdAt   DateTime @default(now())

  schema    OntologySchema     @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  instances OntologyInstance[]
}

model OntologyLinkType {
  id          String   @id @default(uuid())
  schemaId    String
  name        String
  label       String   @default("")
  description String   @default("")
  sourceType  String
  targetType  String
  properties  String   @default("[]")
  cardinality String   @default("many-to-many")
  createdAt   DateTime @default(now())

  schema    OntologySchema     @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  relations OntologyRelation[]
}

model OntologyRule {
  id          String   @id @default(uuid())
  schemaId    String
  name        String
  description String   @default("")
  ruleType    String   @default("custom")
  config      String   @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  schema OntologySchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)
}

model OntologyInstance {
  id          String   @id @default(uuid())
  schemaId    String
  typeId      String
  name        String
  properties  String   @default("{}")
  sourceDocId String?
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schema          OntologySchema     @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  type            OntologyObjectType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  sourceRelations OntologyRelation[] @relation("SourceInstance")
  targetRelations OntologyRelation[] @relation("TargetInstance")
}

model OntologyRelation {
  id         String    @id @default(uuid())
  schemaId   String
  linkTypeId String
  sourceId   String
  targetId   String
  properties String    @default("{}")
  validFrom  DateTime?
  validTo    DateTime?
  isCurrent  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  schema         OntologySchema   @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  linkType       OntologyLinkType @relation(fields: [linkTypeId], references: [id], onDelete: Cascade)
  sourceInstance OntologyInstance @relation("SourceInstance", fields: [sourceId], references: [id], onDelete: Cascade)
  targetInstance OntologyInstance @relation("TargetInstance", fields: [targetId], references: [id], onDelete: Cascade)
}

// ===================== 学术研究系统 (SYLVA) =====================

model ResearchModule {
  id              String   @id @default(uuid())
  name            String
  displayName     String
  category        String
  subcategory     String
  discipline      String
  status          String   @default("active") // active | deprecated | research | complete
  lineCount       Int      @default(0)
  sorryCount      Int      @default(0)
  theoremCount    Int      @default(0)
  definitionCount Int      @default(0)
  filePath        String   @default("")
  leanVersion     String   @default("")
  dependencies    String   @default("[]") // JSON array of module names
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  theorems ResearchTheorem[]
  notes    ResearchNote[]

  @@index([status])
  @@index([category])
  @@index([discipline])
}

model ResearchPaper {
  id               String   @id @default(uuid())
  title            String
  type             String   @default("Hilbert") // Hilbert | Millennium
  number           String   @default("")
  field            String   @default("")
  status           String   @default("open") // solved | partial | open
  abstract         String   @default("")
  keywords         String   @default("[]") // JSON array
  milestones       String   @default("[]") // JSON array
  filePath         String   @default("")
  leanSnippetCount Int      @default(0)
  crossRefCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  notes ResearchNote[]

  @@index([status])
  @@index([type])
  @@index([field])
}

model ResearchTheorem {
  id            String   @id @default(uuid())
  name          String
  statement     String   @default("")
  moduleId      String
  status        String   @default("research") // proven | axiom | research | placeholder
  proofStrategy String   @default("")
  leanCode      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module ResearchModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([status])
}

model ResearchNote {
  id        String   @id @default(uuid())
  title     String
  content   String   @default("")
  tags      String   @default("[]") // JSON array
  moduleId  String?
  paperId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module ResearchModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  paper  ResearchPaper?  @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([moduleId])
  @@index([paperId])
}

model ResearchSync {
  id           String   @id @default(uuid())
  repoName     String   @default("TOE-SYLVA") // TOE-SYLVA | PFE
  commitHash   String
  branch       String   @default("main")
  filesChanged Int      @default(0)
  insertions   Int      @default(0)
  deletions    Int      @default(0)
  syncedAt     DateTime @default(now())

  @@index([repoName])
  @@index([syncedAt])
}

model AcademicPanel {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  domain      String   @default("") // 学科领域：mathematics | physics | biology | ai | interdisciplinary
  status      String   @default("active") // active | disbanded | on-hold
  strategy    String   @default("{}") // 专家组策略：JSON（轮询模式、讨论规则等）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   AcademicPanelMember[]
  workshops AcademicWorkshop[]
  pipelines ManuscriptPipeline[]
}

model AcademicPanelMember {
  id           String   @id @default(uuid())
  panelId      String
  role         String   @default("member") // chair | reviewer | contributor | observer
  specialty    String   @default("") // 专长标签：number_theory | formal_verification | pde etc.
  weight       Float    @default(1.0) // 投票权重
  systemPrompt String   @default("") // 该成员的系统提示词
  model        String   @default("glm-5.1")
  createdAt    DateTime @default(now())

  panel AcademicPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId])
  @@index([specialty])
}

model AcademicWorkshop {
  id           String   @id @default(uuid())
  panelId      String
  title        String
  topic        String   @default("") // 研讨主题/论题
  status       String   @default("planning") // planning | active | review | concluded | cancelled
  mode         String   @default("committee") // committee | debate | sequential | parallel
  maxRounds    Int      @default(5)
  currentRound Int      @default(0)
  consensus    String   @default("") // 最终共识结论
  conclusion   String   @default("") // 详细结论报告
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  panel  AcademicPanel   @relation(fields: [panelId], references: [id], onDelete: Cascade)
  rounds WorkshopRound[]
  tasks  AcademicTask[]

  @@index([panelId])
  @@index([status])
}

model WorkshopRound {
  id             String   @id @default(uuid())
  workshopId     String
  roundNumber    Int
  phase          String   @default("argument") // argument | rebuttal | synthesis | conclusion
  content        String   @default("") // 本轮内容摘要（JSON 记录各成员发言）
  consensusLevel Float    @default(0.0) // 0-1 共识度
  createdAt      DateTime @default(now())

  workshop AcademicWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([roundNumber])
}

model ManuscriptPipeline {
  id           String @id @default(uuid())
  panelId      String
  title        String
  description  String @default("")
  status       String @default("idea") // idea | outline | draft | review | revision | final | publish | archived
  currentStage String @default("idea")
  content      String @default("") // 当前阶段内容（最新稿件）
  history      String @default("[]") // 阶段历史 JSON 数组

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panel  AcademicPanel   @relation(fields: [panelId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  tasks  AcademicTask[]

  @@index([panelId])
  @@index([status])
}

model PipelineStage {
  id           String    @id @default(uuid())
  pipelineId   String
  name         String // idea | outline | draft | review | revision | final | publish
  order        Int
  status       String    @default("pending") // pending | active | completed | rejected | skipped
  assigneeRole String    @default("contributor") // 分配给专家组中的角色
  content      String    @default("") // 阶段产出内容
  feedback     String    @default("") // 评审反馈
  score        Float     @default(0.0) // 0-10 评分
  completedAt  DateTime?

  pipeline ManuscriptPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
  @@index([name])
}

model AcademicTask {
  id            String    @id @default(uuid())
  workshopId    String?
  pipelineId    String?
  panelMemberId String    @default("") // 分配给哪个专家组成员
  title         String
  description   String    @default("")
  type          String    @default("prove") // prove | review | verify | discover | draft | critique | audit
  status        String    @default("pending") // pending | assigned | in-progress | completed | failed | cancelled
  priority      String    @default("normal") // low | normal | high | critical
  targetModule  String    @default("") // 关联的 SYLVA 模块名
  targetPaper   String    @default("") // 关联的论文标题
  result        String    @default("") // 任务结果
  leanCode      String    @default("") // 关联的 Lean 代码
  score         Float     @default(0.0) // 0-10 质量评分
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  academicWorkshop     AcademicWorkshop?   @relation(fields: [academicWorkshopId], references: [id])
  academicWorkshopId   String?
  manuscriptPipeline   ManuscriptPipeline? @relation(fields: [manuscriptPipelineId], references: [id])
  manuscriptPipelineId String?
}

model AcademicReviewBoard {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  domain      String   @default("") // 学科领域
  reviewMode  String   @default("single_blind") // single_blind | double_blind | open
  status      String   @default("active") // active | closed | archived
  strategy    String   @default("{}") // 评审策略 JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviewers ReviewBoardMember[]
  reviews   AcademicReview[]
}

model ReviewBoardMember {
  id           String   @id @default(uuid())
  boardId      String
  role         String   @default("reviewer") // chair | reviewer | secretary
  specialty    String   @default("")
  weight       Float    @default(1.0)
  systemPrompt String   @default("")
  model        String   @default("glm-5.1")
  anonymityId  String   @default("") // 匿名评审编号
  createdAt    DateTime @default(now())

  board AcademicReviewBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([specialty])
}

model AcademicReview {
  id         String   @id @default(uuid())
  boardId    String
  targetType String   @default("paper") // paper | theorem | code | proof
  targetId   String   @default("") // 目标标识
  title      String
  content    String   @default("") // 评审内容
  score      Float    @default(0.0) // 0-10 评分
  decision   String   @default("pending") // accept | minor_revision | major_revision | reject | pending
  round      Int      @default(1) // 评审轮次
  reviewerId String   @default("") // 评审者（可为空表示匿名）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  board AcademicReviewBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([targetId])
  @@index([decision])
}

model AcademicCompetition {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  domain       String   @default("") // 学科领域
  format       String   @default("tournament") // tournament | elimination | round_robin | bracket
  status       String   @default("registration") // registration | active | judging | concluded | cancelled
  maxRounds    Int      @default(5)
  currentRound Int      @default(0)
  criteria     String   @default("{}") // 评分标准 JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competitors AcademicCompetitor[]
  rounds      CompetitionRound[]
}

model AcademicCompetitor {
  id            String   @id @default(uuid())
  competitionId String
  name          String
  specialty     String   @default("")
  role          String   @default("contestant") // contestant | team | algorithm
  systemPrompt  String   @default("")
  model         String   @default("glm-5.1")
  score         Float    @default(0.0)
  rank          Int      @default(0)
  eliminated    Boolean  @default(false)
  createdAt     DateTime @default(now())

  competition AcademicCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([rank])
}

model CompetitionRound {
  id             String   @id @default(uuid())
  competitionId  String
  roundNumber    Int
  phase          String   @default("challenge") // challenge | response | evaluation | result
  topic          String   @default("")
  content        String   @default("") // JSON 记录各参赛者表现
  scores         String   @default("[]") // JSON 评分数组
  consensusLevel Float    @default(0.0)
  createdAt      DateTime @default(now())

  competition AcademicCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([roundNumber])
}

model AcademicMentorship {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  domain      String   @default("") // 学科领域
  mode        String   @default("one_on_one") // one_on_one | group | peer | socratic
  status      String   @default("active") // active | paused | completed | cancelled
  curriculum  String   @default("[]") // JSON 课程大纲
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions MentorshipSession[]
}

model MentorshipSession {
  id              String    @id @default(uuid())
  mentorshipId    String
  title           String
  topic           String    @default("")
  mode            String    @default("lecture") // lecture | exercise | discussion | critique | review
  content         String    @default("") // 会话内容记录
  feedback        String    @default("") // 导师反馈
  studentResponse String    @default("") // 学生回应
  score           Float     @default(0.0) // 0-10 学习评分
  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  mentorship AcademicMentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  @@index([mentorshipId])
  @@index([completed])
}

model CodeReviewGroup {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  targetModule String   @default("") // 关联的 SYLVA 模块
  targetFile   String   @default("") // 关联的 Lean 文件路径
  status       String   @default("active") // active | concluded | archived
  reviewMode   String   @default("line_by_line") // line_by_line | overall | structured | interactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewers CodeReviewMember[]
  reviews   CodeReview[]
}

model CodeReviewMember {
  id           String   @id @default(uuid())
  groupId      String
  role         String   @default("reviewer") // lead_reviewer | reviewer | contributor | observer
  specialty    String   @default("") // formal_verification | lean4 | mathematics | physics
  systemPrompt String   @default("")
  model        String   @default("glm-5.1")
  createdAt    DateTime @default(now())

  group CodeReviewGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([specialty])
}

model CodeReview {
  id         String   @id @default(uuid())
  groupId    String
  lineStart  Int      @default(0)
  lineEnd    Int      @default(0)
  targetCode String   @default("") // 被审查代码片段
  comment    String   @default("") // 评审意见
  severity   String   @default("suggestion") // critical | major | minor | suggestion | praise
  reviewerId String   @default("")
  status     String   @default("open") // open | resolved | dismissed | pending
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group CodeReviewGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([severity])
  @@index([status])
}

model ValidationGroup {
  id             String   @id @default(uuid())
  name           String
  description    String   @default("")
  targetModule   String   @default("") // 关联的 SYLVA 模块
  targetTheorem  String   @default("") // 关联的定理
  validationType String   @default("numerical") // numerical | symbolic | experimental | cross_reference | peer
  status         String   @default("active") // active | completed | failed | archived
  strategy       String   @default("{}") // 验证策略 JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  validators ValidationMember[]
  results    ValidationResult[]
}

model ValidationMember {
  id           String   @id @default(uuid())
  groupId      String
  role         String   @default("validator") // lead_validator | validator | witness | checker
  specialty    String   @default("")
  systemPrompt String   @default("")
  model        String   @default("glm-5.1")
  createdAt    DateTime @default(now())

  group ValidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([specialty])
}

model ValidationResult {
  id          String   @id @default(uuid())
  groupId     String
  validatorId String   @default("")
  method      String   @default("") // 验证方法
  input       String   @default("") // 验证输入
  output      String   @default("") // 验证输出
  conclusion  String   @default("pending") // verified | refuted | inconclusive | pending
  confidence  Float    @default(0.0) // 0-1 置信度
  details     String   @default("") // 详细说明
  createdAt   DateTime @default(now())

  group ValidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([conclusion])
}
