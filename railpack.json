{
  "apps": {
    "web": {
      "root": ".",
      "build": {
        "steps": [
          { "command": "bun install" },
          { "command": "bun run postinstall" },
          { "command": "bun run build" }
        ]
      },
      "deploy": {
        "command": "bun run start",
        "port": 3000
      }
    }
  }
}
